<section class="py-12 px-6 lg:px-10 transition-colors duration-300 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="text-[9px] tracking-[0.42em] uppercase mb-3 font-medium" style="color: #A87052;">{{ section.settings.eyebrow }}</p>
        <h2 class="font-light font-display text-[clamp(22px,3vw,30px)] text-[#2D2E2D] transition-colors">{{ section.settings.heading }}</h2>
      </div>
      <div class="flex gap-0.5" aria-label="5 stars rating">
        {%- for i in (1..5) -%}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#A87052">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        {%- endfor -%}
      </div>
    </div>

    <div class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar md:grid md:grid-cols-3 gap-4 pb-4 -mx-6 px-6 md:mx-0 md:px-0">
      {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }} class="w-[82vw] sm:w-[60vw] md:w-auto shrink-0 snap-start px-6 py-5 bg-[#FAF8F5] transition-colors duration-300">
        <p class="italic text-sm leading-relaxed mb-4 font-display text-[16px] text-[#494D57]">
          &ldquo;{{ block.settings.quote | escape }}&rdquo;
        </p>
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-medium flex-shrink-0" style="background: rgba(168, 112, 82, 0.2); color: #A87052;">
            {{ block.settings.name | slice: 0, 1 }}
          </div>
          <div>
            <p class="text-xs font-medium text-[#2D2E2D]">{{ block.settings.name }}</p>
            <p class="text-[9px] text-[#494D57]">{{ block.settings.location }}</p>
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Customer Love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "location", "label": "Location" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
