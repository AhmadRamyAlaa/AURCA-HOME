<header data-header class="sticky top-0 w-full z-50 transition-all duration-300" style="background: {{ section.settings.bg_color }};">


  {%- comment -%} Main Header Bar (110px height) {%- endcomment -%}
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between relative" style="height: 110px;">
      
      {%- comment -%} Left Navigation (Desktop) {%- endcomment -%}
      <nav class="hidden lg:flex items-center gap-10 z-20">
        {%- assign nav = linklists[section.settings.menu] -%}
        {%- if nav.links.size > 0 -%}
          {%- for link in nav.links -%}
            <a href="{{ link.url }}" class="text-white/70 hover:text-white transition-colors text-[11px] tracking-[0.2em] uppercase font-medium">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
       
        <a href="{{ collections['men'].url | default: routes.all_products_collection_url }}" class="text-white/70 hover:text-white transition-colors text-[11px] tracking-[0.2em] uppercase font-medium" data-i18n="men">
          Men
        </a>
        <a href="{{ collections['women'].url | default: routes.all_products_collection_url }}" class="text-white/70 hover:text-white transition-colors text-[11px] tracking-[0.2em] uppercase font-medium" data-i18n="women">
          Women
        </a>
        <a href="{{ collections['together'].url | default: routes.all_products_collection_url }}" class="text-white/70 hover:text-white transition-colors text-[11px] tracking-[0.2em] uppercase font-medium" data-i18n="together">
          Together
        </a>
        {%- endif -%}
      </nav>

      {%- comment -%} Mobile Hamburger Menu Button {%- endcomment -%}
      <div class="lg:hidden flex items-center z-20">
        <button type="button" data-menu-open class="text-white/80 hover:text-white p-2" aria-label="Toggle menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

      {%- comment -%} Center Brand Wordmark Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center z-10">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'h-6 md:h-7 w-auto object-contain flex-shrink-0', style: 'max-height: 28px;' }}
        {%- else -%}
          <img src="{{ 'logo-wordmark-cream.svg' | asset_url }}" alt="{{ shop.name }}" class="h-6 md:h-7 w-auto object-contain flex-shrink-0" style="max-height: 28px;">
        {%- endif -%}
      </a>

      {%- comment -%} Right Controls (Desktop) {%- endcomment -%}
      <div class="hidden lg:flex items-center gap-5 z-20">
        {%- comment -%} Search Button {%- endcomment -%}
        <button type="button" data-search-open class="text-white/65 hover:text-white transition-colors p-1" title="Search" aria-label="Search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>

        {%- comment -%} Account Button {%- endcomment -%}
        <a href="{{ routes.account_url }}" class="text-white/65 hover:text-white transition-colors p-1" title="Account" aria-label="Account">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>

        {%- comment -%} Wishlist Button {%- endcomment -%}
        <button type="button" data-wishlist-open class="text-white/65 hover:text-white transition-colors p-1 relative" title="Wishlist" aria-label="Wishlist">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span data-wishlist-count class="absolute -top-1.5 -right-1.5 bg-[#2D2E2D] text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-medium hidden">0</span>
        </button>

        {%- comment -%} Bag Button {%- endcomment -%}
        <button type="button" data-cart-open class="text-white/65 hover:text-white transition-colors p-1 relative" title="Bag" aria-label="Bag">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span data-cart-count class="absolute -top-1.5 -right-1.5 bg-[#2D2E2D] text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-medium {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </button>
      </div>

      {%- comment -%} Right Controls (Mobile) {%- endcomment -%}
      <div class="lg:hidden flex items-center gap-3 z-20">
        <button type="button" data-wishlist-open class="text-white/80 p-1 relative" aria-label="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span data-wishlist-count class="absolute -top-1.5 -right-1.5 bg-[#2D2E2D] text-white text-[8px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-medium hidden">0</span>
        </button>
        <button type="button" data-cart-open class="text-white/80 p-1 relative" aria-label="Bag">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span data-cart-count class="absolute -top-1.5 -right-1.5 bg-[#2D2E2D] text-white text-[8px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-medium {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Mobile Navigation Drawer {%- endcomment -%}
  <div data-menu hidden class="lg:hidden bg-[#2D2E2D] text-white border-t border-white/10 px-6 py-6 transition-all duration-300 shadow-2xl">
    <div class="flex flex-col gap-4 mb-6">
      <a href="{{ routes.all_products_collection_url }}" class="text-white/80 hover:text-white font-medium text-xs tracking-[0.2em] uppercase py-2" data-i18n="tab_all">All</a>
      <a href="{{ collections['men'].url | default: routes.all_products_collection_url }}" class="text-white/80 hover:text-white font-medium text-xs tracking-[0.2em] uppercase py-2" data-i18n="men">Men</a>
      <a href="{{ collections['women'].url | default: routes.all_products_collection_url }}" class="text-white/80 hover:text-white font-medium text-xs tracking-[0.2em] uppercase py-2" data-i18n="women">Women</a>
      <a href="{{ collections['together'].url | default: routes.all_products_collection_url }}" class="text-white/80 hover:text-white font-medium text-xs tracking-[0.2em] uppercase py-2" data-i18n="together">Together</a>
      <a href="#lookbook" class="text-white/80 hover:text-white font-medium text-xs tracking-[0.2em] uppercase py-2" data-i18n="lookbook">Lookbook</a>
    </div>
    <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
      <button type="button" data-search-open class="text-white/80 text-[10px] tracking-[0.18em] uppercase border border-white/20 px-3 py-1.5">Search</button>
      <a href="{{ routes.account_url }}" class="text-white/80 text-[10px] tracking-[0.18em] uppercase border border-white/20 px-3 py-1.5">Account</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the default wordmark" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Leave empty to use Women / Men / Together" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#A87052" }
  ]
}
{% endschema %}
