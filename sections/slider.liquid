<section data-hero-slider class="relative overflow-hidden w-full select-none" style="height: 92vh; min-height: 560px;">
  {%- for block in section.blocks -%}
  <div data-slide {{ block.shopify_attributes }} class="hero-slide absolute inset-0 transition-opacity duration-700 {% if forloop.first %}opacity-100 z-10{% else %}opacity-0 z-0{% endif %}" data-index="{{ forloop.index0 }}">
    {%- assign alt = block.settings.image.alt | default: block.settings.title | strip_html -%}
    {%- if block.settings.image != blank -%}
      {%- if forloop.first -%}{{ block.settings.image | image_url: width: 1800 | image_tag: widths: '750, 1080, 1800', sizes: '100vw', alt: alt, fetchpriority: 'high', class: 'w-full h-full object-cover object-center' }}{%- else -%}{{ block.settings.image | image_url: width: 1800 | image_tag: widths: '750, 1080, 1800', sizes: '100vw', alt: alt, class: 'w-full h-full object-cover object-center', loading: 'lazy' }}{%- endif -%}
    {%- elsif block.settings.image_url != blank -%}
      <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | strip_html | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} class="w-full h-full object-cover object-center">
    {%- else -%}
      <div class="w-full h-full bg-[#2D2D2D]"></div>
    {%- endif -%}
    <div class="absolute inset-0 z-10" style="background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 55%, rgba(0,0,0,0.1) 100%);"></div>
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 pb-20 lg:pb-24">
        <div class="max-w-xl">
          <div class="flex items-center gap-3 mb-5">
            <img src="{{ 'logo-monogram-flower.svg' | asset_url }}" alt="" class="w-5 h-5 object-contain brightness-0 invert opacity-55">
            <span class="text-white/50 text-[9px] tracking-[0.42em] uppercase">{{ block.settings.label }}</span>
          </div>
          <h1 class="text-white font-light leading-[0.93] mb-5 font-display text-[clamp(48px,7vw,84px)]">{%- assign parts = block.settings.title | split: '|' -%}{{ parts[0] }}{% if parts.size > 1 %}<br><em class="italic">{{ parts[1] }}</em>{% endif %}</h1>
          <p class="text-white/60 text-sm leading-relaxed mb-8 max-w-sm">{{ block.settings.text }}</p>
          {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link | default: '#collections' }}" class="inline-flex items-center gap-3 text-white text-[10px] tracking-[0.22em] uppercase px-8 py-4 transition-opacity hover:opacity-80" style="background: #A87052;">
            <span>{{ block.settings.button_label }}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- endfor -%}

  {%- comment -%} Navigation Arrows {%- endcomment -%}
  <button type="button" data-hero-prev class="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center bg-black/25 hover:bg-black/45 transition-colors" style="backdrop-filter: blur(4px);" aria-label="Previous slide">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button type="button" data-hero-next class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center bg-black/25 hover:bg-black/45 transition-colors" style="backdrop-filter: blur(4px);" aria-label="Next slide">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><path d="M9 18l6-6-6-6"/></svg>
  </button>

  {%- comment -%} Pagination Indicators (Pills) {%- endcomment -%}
  <div class="absolute bottom-6 left-0 right-0 z-20 flex justify-center gap-2">
    {%- for block in section.blocks -%}
    <button type="button" data-hero-dot="{{ forloop.index0 }}" class="hero-dot transition-all duration-300" style="height: 3px; width: {% if forloop.first %}28px; background: white{% else %}10px; background: rgba(255,255,255,0.38){% endif %};" aria-label="Go to slide {{ forloop.index }}"></button>
    {%- endfor -%}
  </div>

  {%- comment -%} Slide Counter (Desktop) {%- endcomment -%}
  <div class="absolute right-8 bottom-20 lg:bottom-24 z-20 hidden lg:flex items-center gap-2">
    <span data-hero-current class="text-white text-sm font-light">01</span>
    <div class="w-8 h-px bg-white/30"></div>
    <span class="text-white/40 text-sm font-light">{{ section.blocks.size | prepend: "0" | slice: -2, 2 }}</span>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slider",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL (used only if no image is uploaded)" },
        { "type": "text", "id": "label", "label": "Small label" },
        { "type": "text", "id": "title", "label": "Heading", "info": "Put | where the line breaks; the text after it is shown in italics." },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Hero Slider", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
